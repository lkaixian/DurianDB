  {
    "id": "c_1 70",
    "type": "comment",
    "name": "1  Push values with HTTP POST",
    "info": "Needs an ingest token for an http_in source. One value, a batch, or a flat {point: value} map are all accepted. ts is optional (epoch seconds or milliseconds, or ISO-8601). The reply lists accepted and rejected values.",
    "x": 170,
    "y": 70,
    "wires": [],
    "z": "durian_tab"
  },
  {
    "id": "in_post",
    "type": "inject",
    "name": "Push now",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 150,
    "y": 110,
    "wires": [
      [
        "fn_post"
      ]
    ],
    "z": "durian_tab"
  },
  {
    "id": "fn_post",
    "type": "function",
    "name": "Build the request",
    "func": "const base = env.get(\"DURIAN_URL\") || \"http://127.0.0.1:8765\";\nmsg.method = \"POST\";\nmsg.url = base + \"/api/ingest/\" + env.get(\"DURIAN_SOURCE\");\nmsg.headers = {\"Authorization\": \"Bearer \" + env.get(\"DURIAN_INGEST_TOKEN\"), \"Content-Type\": \"application/json\"};\n// a batch: several points, each with its own time\nmsg.payload = {values: [\n  {point: \"temp\",  value: Math.round((20 + Math.random() * 5) * 10) / 10, ts: Date.now()},\n  {point: \"level\", value: Math.round(Math.random() * 100) / 10, ts: Date.now()}\n]};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 110,
    "wires": [
      [
        "hr_post"
      ]
    ],
    "z": "durian_tab"
  },
  {
    "id": "hr_post",
    "type": "http request",
    "name": "DurianDB",
    "method": "use",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "x": 620,
    "y": 110,
    "wires": [
      [
        "keep_post"
      ]
    ],
    "z": "durian_tab"
  },
  {
    "id": "keep_post",
    "type": "function",
    "name": "Remember result",
    "func": "global.set(\"last_post\", {status: msg.statusCode, body: msg.payload});\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 800,
    "y": 110,
    "wires": [
      [
        "dbg_post"
      ]
    ],
    "z": "durian_tab"
  },
