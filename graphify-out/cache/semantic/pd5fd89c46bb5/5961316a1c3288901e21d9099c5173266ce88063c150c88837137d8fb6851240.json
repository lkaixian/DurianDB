{"nodes": [{"id": "docs_research_09_dashboards_document", "label": "09 Dashboards and the extension question", "file_type": "document", "source_file": "docs/research/09-dashboards.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_09_dashboards_studied_ui_config_json", "label": "Studied product: UI config as generic JSON documents with role lists", "file_type": "concept", "source_file": "docs/research/09-dashboards.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_09_dashboards_studied_pages_as_code", "label": "Studied product: pages are HTML/script code (ma-* components)", "file_type": "concept", "source_file": "docs/research/09-dashboards.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pages that are code are powerful and dangerous. Anyone who can save a page can run script as every viewer, so edit permission is effectively administrator permission (stored-XSS class by design)."}, {"id": "docs_research_09_dashboards_stored_xss_risk", "label": "Stored-XSS risk of pages that are code", "file_type": "concept", "source_file": "docs/research/09-dashboards.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_09_dashboards_dashboards_as_data", "label": "Dashboards as data, not code", "file_type": "concept", "source_file": "docs/research/09-dashboards.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A dashboard is JSON (title, columns, refresh, read roles, edit roles, owner, widgets). Nothing an author saves is parsed as HTML or executed, so a saved dashboard can never run code."}, {"id": "docs_research_09_dashboards_strict_content_policy", "label": "Strict content policy (no inline script or style)", "file_type": "concept", "source_file": "docs/research/09-dashboards.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Widgets rendered by server-shipped code keep the strict content policy on; loosening it for uploaded code would give every designer the power of the studied product's pages."}, {"id": "docs_research_09_dashboards_tones", "label": "Three fixed tones (normal, warn, alarm)", "file_type": "concept", "source_file": "docs/research/09-dashboards.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bounded version of free CSS value bindings: rules {op, value, tone}. Tones also use weight and underline, not colour alone (accessibility)."}, {"id": "docs_research_09_dashboards_visibility_vs_data_access", "label": "Dashboard visibility separate from data access", "file_type": "concept", "source_file": "docs/research/09-dashboards.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Visibility of a page and access to the data it shows are separate questions. A public dashboard does not make its data public; saving warns naming each point anonymous cannot read. Common mistake: publishing a page and assuming its data is published."}, {"id": "docs_research_09_dashboards_anonymous_role", "label": "Anonymous role held by everyone", "file_type": "concept", "source_file": "docs/research/09-dashboards.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Public means the role anonymous in read roles; everyone, signed in or not, holds it. Fixed: a user with only a custom role did not count as anonymous. Only superadmin can make a dashboard public."}, {"id": "docs_research_09_dashboards_designer_role", "label": "Designer role required to create dashboards", "file_type": "concept", "source_file": "docs/research/09-dashboards.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Creating needs the designer role (or superadmin)."}, {"id": "docs_research_09_dashboards_owner_edit_roles", "label": "Owner and edit_roles edit permission", "file_type": "concept", "source_file": "docs/research/09-dashboards.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Edit permission is owner, edit_roles, or superadmin; owner is immutable."}, {"id": "docs_research_09_dashboards_widget_extension_pair", "label": "Widget extension pair (validator plus renderer)", "file_type": "concept", "source_file": "docs/research/09-dashboards.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adding a widget type is two small reviewable pieces: a validator registered with @widget(name) in durian/dashboards.py and a registerWidget(name, {...}) renderer in web/dashboards.js. Whoever runs the server installs them."}, {"id": "docs_research_09_dashboards_no_ui_widget_upload", "label": "No UI upload of widget code", "file_type": "concept", "source_file": "docs/research/09-dashboards.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberate: with a strict content policy uploaded code could not run, and loosening the policy would give every designer the power of the studied product's pages."}, {"id": "docs_research_09_dashboards_sandboxed_frame_option", "label": "Sandboxed frame with own origin (not built)", "file_type": "concept", "source_file": "docs/research/09-dashboards.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Safe route if untrusted authors ever need custom visuals; not built."}, {"id": "docs_research_09_dashboards_designer_form", "label": "Designer as form with move/size buttons and live preview", "file_type": "concept", "source_file": "docs/research/09-dashboards.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keyboard usable and testable; drag and drop is a later layer over the same data."}, {"id": "docs_research_09_dashboards_widget_types", "label": "Widget types (value, gauge, chart, alarms, table, setpoint, text, status)", "file_type": "concept", "source_file": "docs/research/09-dashboards.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_09_dashboards_validation_paths", "label": "Validation with error paths, grid fit/overlap, warnings", "file_type": "concept", "source_file": "docs/research/09-dashboards.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_09_dashboards_menu_as_dashboard_list", "label": "Dashboards list plus #d/name links instead of menu items", "file_type": "concept", "source_file": "docs/research/09-dashboards.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One mechanism instead of two."}, {"id": "docs_research_09_dashboards_not_built", "label": "Not built (drag and drop, templates, URL params, per-user, themes, menu editor)", "file_type": "concept", "source_file": "docs/research/09-dashboards.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_09_dashboards_checked", "label": "Checks: tests/test_dashboards.py and browser_dashboard.mjs", "file_type": "concept", "source_file": "docs/research/09-dashboards.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_research_09_dashboards_document", "target": "docs_r