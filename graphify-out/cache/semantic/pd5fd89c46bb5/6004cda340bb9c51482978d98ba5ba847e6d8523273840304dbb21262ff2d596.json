{"nodes": [{"id": "docs_research_07_modbus_doc", "label": "Note 07: Modbus studied behavior and driver", "file_type": "document", "source_file": "docs/research/07-modbus.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_07_modbus_byteword", "label": "byte_order and word_order switches", "file_type": "concept", "source_file": "docs/research/07-modbus.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two independent switches (bytes inside each register, registers within a value) replace the vendor named swapped variants; four combinations cover every variant."}, {"id": "docs_research_07_modbus_contiguousonly", "label": "Contiguous-only batching by default", "file_type": "concept", "source_file": "docs/research/07-modbus.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Safe choice: reading an unmapped register can make some devices refuse the whole read. With it off, gaps up to 16 registers are bridged."}, {"id": "docs_research_07_modbus_backoff", "label": "Failure back-off period x scale^failures, capped", "file_type": "concept", "source_file": "docs/research/07-modbus.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A dead link must not be hammered; wait grows by scale factor to a cap. A device that rejects one read only loses those points."}, {"id": "docs_research_07_modbus_noretryexception", "label": "Modbus exception responses raised, not retried", "file_type": "concept", "source_file": "docs/research/07-modbus.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retrying cannot change the device answer."}, {"id": "docs_research_07_modbus_unitids", "label": "Unit ids 1 to 247", "file_type": "concept", "